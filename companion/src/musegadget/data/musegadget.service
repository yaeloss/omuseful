# Keeps the device connected to its Muse. Runs as root (device credentials).
# Modified by yaeloss for Omuseful: a chat-only device; it runs no commands.
# Sandboxing is added by the omuseful.conf drop-in.

[Unit]
Description=Muse Home Link (Linux Device SDK)
Wants=network-online.target
After=network-online.target bluetooth.target

[Service]
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/musegadget/venv/bin/musegadget run
RuntimeDirectory=musegadget
RuntimeDirectoryMode=0755
StateDirectory=musegadget
StateDirectoryMode=0700
# Installed on every setup path, including without the optional access drop-in.
# Backstop for parser/runtime allocations beyond the per-response byte limits.
MemoryAccounting=yes
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=0
OOMPolicy=kill
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
